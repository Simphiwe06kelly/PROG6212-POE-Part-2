@model HomeViewModel
@inject UserSession CurrentUser
@{
    ViewData["Title"] = "Find your next race";
    var filter = Model.Filter;
}

<section class="rd-hero">
    <div class="container">
        <p class="rd-eyebrow">Road running &bull; Walking &bull; Cycling</p>
        <h1 class="rd-hero-title">Find your next <span>start line</span>.</h1>
        <p class="rd-hero-lead">Browse upcoming events across South Africa, pick your distance and enter in a few clicks.</p>
        @if (!CurrentUser.IsLoggedIn)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-rd btn-lg me-2">Join RaceDay</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Log in</a>
        }
        else if (CurrentUser.IsOrganiser)
        {
            <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-rd btn-lg"><i class="bi bi-plus-circle-fill"></i> Create an event</a>
        }
        else
        {
            <a asp-controller="Participant" asp-action="MyEnrolments" class="btn btn-rd btn-lg"><i class="bi bi-ticket-perforated"></i> My enrolments</a>
        }
    </div>
</section>

<div class="container my-4">
    <form method="get" asp-controller="Home" asp-action="Index" class="rd-filter card">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label for="search" class="form-label">Search</label>
                    <input id="search" name="search" type="text" class="form-control" placeholder="Event name or city" value="@filter.Search" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label for="type" class="form-label">Type</label>
                    <select id="type" name="type" class="form-select">
                        <option value="">All types</option>
                        <option value="Run" selected="@(filter.Type == "Run")">Run</option>
                        <option value="Walk" selected="@(filter.Type == "Walk")">Walk</option>
                        <option value="Cycle" selected="@(filter.Type == "Cycle")">Cycle</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label for="province" class="form-label">Province</label>
                    <select id="province" name="province" class="form-select">
                        <option value="">All provinces</option>
                        @foreach (var province in Model.Provinces)
                        {
                            <option value="@province" selected="@(string.Equals(filter.Province, province, StringComparison.OrdinalIgnoreCase))">@province</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <label for="from" class="form-label">From</label>
                    <input id="from" name="from" type="date" class="form-control" value="@(filter.From?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <label for="to" class="form-label">To</label>
                    <input id="to" name="to" type="date" class="form-control" value="@(filter.To?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-lg-1 col-12 d-grid">
                    <button type="submit" class="btn btn-rd"><i class="bi bi-funnel-fill"></i></button>
                </div>
            </div>
            @if (filter.IsActive)
            {
                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="small"><i class="bi bi-x-circle"></i> Clear filters</a>
                </div>
            }
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-end mt-4 mb-3">
        <h2 class="rd-heading mb-0">@(filter.IsActive ? "Matching events" : "Upcoming events")</h2>
        <span class="text-muted small">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events")</span>
    </div>

    @if (Model.LoadError != null)
    {
        <div class="alert alert-warning"><i class="bi bi-wifi-off"></i> @Model.LoadError</div>
    }
    else if (!Model.Events.Any())
    {
        <div class="rd-empty">
            <i class="bi bi-calendar-x"></i>
            <h3>No events found</h3>
            <p>@(filter.IsActive ? "Try widening your filters or clearing them." : "There are no upcoming events yet. Check back soon.")</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Events)
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_EventCard" model="item" />
                </div>
            }
        </div>
    }
</div>
