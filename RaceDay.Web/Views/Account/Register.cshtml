@model RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
}

<div class="container rd-auth-wrap">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card rd-panel rd-auth-card">
                <div class="card-body p-4 p-md-5">
                    <h1 class="rd-heading">Join RaceDay</h1>
                    <p class="text-muted">Create a free account. Choose Participant to enter events, or Organiser to run them.</p>

                    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                        <div class="mb-4">
                            <label class="form-label d-block">I want to...</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="role-participant" />
                                    <label class="btn rd-role-choice w-100" for="role-participant">
                                        <i class="bi bi-person-walking"></i>
                                        <strong>Enter events</strong>
                                        <small>Participant</small>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="role-organiser" />
                                    <label class="btn rd-role-choice w-100" for="role-organiser">
                                        <i class="bi bi-clipboard-data"></i>
                                        <strong>Run events</strong>
                                        <small>Organiser</small>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-rd btn-lg w-100">Create account</button>
                    </form>

                    <p class="text-center mt-4 mb-0">Already have an account? <a asp-action="Login">Log in</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
