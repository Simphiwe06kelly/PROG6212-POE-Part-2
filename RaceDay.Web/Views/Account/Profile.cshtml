@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="container my-4">
    <h1 class="rd-heading mb-4">My profile</h1>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card rd-panel text-center h-100">
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.PictureUrl))
                    {
                        <img src="@Model.PictureUrl" alt="Your profile picture" class="rd-avatar rd-avatar-xl mb-3" />
                    }
                    else
                    {
                        <div class="rd-avatar rd-avatar-xl mb-3">@Format.Initials(Model.FullName)</div>
                    }
                    <h2 class="h5 mb-1">@Model.FullName</h2>
                    <span class="badge rd-role-pill">@Model.Role</span>
                    @if (Model.MemberSince != default)
                    {
                        <p class="small text-muted mt-2 mb-3">Member since @Format.ShortDate(Model.MemberSince)</p>
                    }

                    <form asp-controller="Account" asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start mt-3">
                        <label for="picture" class="form-label">Profile picture</label>
                        <input id="picture" name="picture" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" required />
                        <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB.</div>
                        <button type="submit" class="btn btn-outline-dark w-100 mt-3"><i class="bi bi-cloud-arrow-up"></i> Upload picture</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card rd-panel">
                <div class="card-body p-4">
                    <h2 class="rd-heading h4">Personal information</h2>
                    <form asp-controller="Account" asp-action="Profile" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Account type</label>
                            <input class="form-control" value="@Model.Role" disabled />
                            <div class="form-text">Your account type can't be changed.</div>
                        </div>
                        <button type="submit" class="btn btn-rd">Save changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
