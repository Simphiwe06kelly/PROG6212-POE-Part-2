@model CategoriesViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Categories - " + ev.EventName;
}

<div class="container my-4">
    <a asp-action="Events" class="small"><i class="bi bi-arrow-left"></i> Back to my events</a>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-2 mb-4">
        <div>
            <h1 class="rd-heading mb-0">Race categories</h1>
            <p class="text-muted mb-0">@ev.EventName &middot; @Format.ShortDate(ev.EventDate)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Enrolments" asp-route-id="@ev.EventID" class="btn btn-outline-dark">Enrolments</a>
            <a asp-action="Results" asp-route-id="@ev.EventID" class="btn btn-outline-dark">Results</a>
        </div>
    </div>

    <div class="card rd-panel mb-4">
        <div class="card-body p-4">
            <h2 class="rd-heading h5">Add a category</h2>
            <p class="text-muted small">Categories are the races people can enter, for example 5km, 10km, 21km, Under 20 or Senior.</p>
            <form asp-action="SaveCategory" method="post" novalidate>
                <input type="hidden" name="EventId" value="@ev.EventID" />
                <input type="hidden" name="CategoryId" value="0" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="new-name" class="form-label">Category name</label>
                        <input id="new-name" name="CategoryName" class="form-control" placeholder="e.g. 10km or Under 20" maxlength="50" required />
                    </div>
                    <div class="col-md-2 col-6">
                        <label for="new-distance" class="form-label">Distance (km)</label>
                        <input id="new-distance" name="DistanceKm" type="number" step="0.01" min="0.01" max="999.99" class="form-control" required />
                    </div>
                    <div class="col-md-2 col-6">
                        <label for="new-fee" class="form-label">Entry fee (R)</label>
                        <input id="new-fee" name="EntryFee" type="number" step="0.01" min="0" value="0" class="form-control" required />
                    </div>
                    <div class="col-md-2 col-6">
                        <label for="new-max" class="form-label">Max participants</label>
                        <input id="new-max" name="MaxParticipants" type="number" min="1" value="100" class="form-control" required />
                    </div>
                    <div class="col-md-2 col-6 d-grid">
                        <button type="submit" class="btn btn-rd"><i class="bi bi-plus-lg"></i> Add</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card rd-panel">
        <div class="card-body">
            <h2 class="rd-heading h5">Categories for this event</h2>
            @if (!ev.Categories.Any())
            {
                <p class="text-muted mb-0">No categories yet. Add one above so participants can enter.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead>
                            <tr><th>Category</th><th>Distance</th><th>Entry fee</th><th>Max participants</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var category in ev.Categories.OrderBy(c => c.DistanceKm))
                            {
                                <tr>
                                    <td class="fw-semibold">@category.CategoryName</td>
                                    <td>@Format.Distance(category.DistanceKm)</td>
                                    <td>@Format.Money(category.EntryFee)</td>
                                    <td>@category.MaxParticipants</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="collapse"
                                                data-bs-target="#edit-@category.CategoryID" aria-expanded="false">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <form asp-action="DeleteCategory" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this category?');">
                                            <input type="hidden" name="eventId" value="@ev.EventID" />
                                            <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <tr class="collapse" id="edit-@category.CategoryID">
                                    <td colspan="5" class="rd-edit-row">
                                        <form asp-action="SaveCategory" method="post" novalidate>
                                            <input type="hidden" name="EventId" value="@ev.EventID" />
                                            <input type="hidden" name="CategoryId" value="@category.CategoryID" />
                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label">Category name</label>
                                                    <input name="CategoryName" class="form-control form-control-sm" value="@category.CategoryName" maxlength="50" required />
                                                </div>
                                                <div class="col-md-2 col-6">
                                                    <label class="form-label">Distance (km)</label>
                                                    <input name="DistanceKm" type="number" step="0.01" min="0.01" max="999.99" class="form-control form-control-sm" value="@category.DistanceKm.ToString("0.##")" required />
                                                </div>
                                                <div class="col-md-2 col-6">
                                                    <label class="form-label">Entry fee (R)</label>
                                                    <input name="EntryFee" type="number" step="0.01" min="0" class="form-control form-control-sm" value="@category.EntryFee.ToString("0.##")" required />
                                                </div>
                                                <div class="col-md-2 col-6">
                                                    <label class="form-label">Max participants</label>
                                                    <input name="MaxParticipants" type="number" min="1" class="form-control form-control-sm" value="@category.MaxParticipants" required />
                                                </div>
                                                <div class="col-md-2 col-6 d-grid">
                                                    <button type="submit" class="btn btn-rd btn-sm">Save</button>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
