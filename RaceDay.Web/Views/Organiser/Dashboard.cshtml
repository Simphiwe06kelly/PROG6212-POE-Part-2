@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var today = DateTime.Today;
    var next = Model.Upcoming.FirstOrDefault();
    var past = Model.Events.Where(e => e.EventDate.Date < today).OrderByDescending(e => e.EventDate).ToList();
}

<div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
        <div>
            <h1 class="rd-heading mb-0">Organiser dashboard</h1>
            <p class="text-muted mb-0">A summary of the events you run.</p>
        </div>
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-rd"><i class="bi bi-plus-circle-fill"></i> Create event</a>
    </div>

    @if (Model.LoadError != null)
    {
        <div class="alert alert-warning"><i class="bi bi-wifi-off"></i> @Model.LoadError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="rd-stat"><div class="rd-stat-number">@Model.Events.Count</div><div class="rd-stat-label">Events created</div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="rd-stat"><div class="rd-stat-number">@Model.Upcoming.Count</div><div class="rd-stat-label">Upcoming events</div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="rd-stat"><div class="rd-stat-number">@Model.TotalEnrolments</div><div class="rd-stat-label">Total enrolments</div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="rd-stat rd-stat-accent">
                @if (next != null)
                {
                    <div class="rd-stat-number">@next.EventDate.ToString("dd MMM")</div>
                    <div class="rd-stat-label">Next: @next.EventName</div>
                }
                else
                {
                    <div class="rd-stat-number">-</div>
                    <div class="rd-stat-label">No upcoming events</div>
                }
            </div>
        </div>
    </div>

    <div class="card rd-panel mb-4">
        <div class="card-body">
            <h2 class="rd-heading h4">Upcoming events</h2>
            @if (!Model.Upcoming.Any())
            {
                <p class="text-muted mb-0">You have no upcoming events. <a asp-action="CreateEvent">Create one</a> to get started.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th>Starts in</th><th class="text-center">Enrolments</th><th class="text-end">Manage</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Upcoming)
                            {
                                var days = (item.EventDate.Date - today).Days;
                                <tr>
                                    <td class="fw-semibold"><span class="rd-type-dot @Format.TypeClass(item.EventType)"></span> @item.EventName</td>
                                    <td>@Format.ShortDate(item.EventDate)</td>
                                    <td>@(days == 0 ? "Today" : days == 1 ? "Tomorrow" : days + " days")</td>
                                    <td class="text-center"><span class="rd-count">@(item.EnrolmentCount ?? 0)</span></td>
                                    <td class="text-end">
                                        <a asp-action="Categories" asp-route-id="@item.EventID" class="btn btn-outline-dark btn-sm">Categories</a>
                                        <a asp-action="Enrolments" asp-route-id="@item.EventID" class="btn btn-outline-dark btn-sm">Enrolments</a>
                                        <a asp-action="EditEvent" asp-route-id="@item.EventID" class="btn btn-outline-dark btn-sm">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (past.Any())
    {
        <div class="card rd-panel">
            <div class="card-body">
                <h2 class="rd-heading h4">Past events</h2>
                <div class="table-responsive">
                    <table class="table rd-table align-middle mb-0">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th class="text-center">Enrolments</th><th class="text-end">Manage</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in past)
                            {
                                <tr>
                                    <td class="fw-semibold"><span class="rd-type-dot @Format.TypeClass(item.EventType)"></span> @item.EventName</td>
                                    <td>@Format.ShortDate(item.EventDate)</td>
                                    <td class="text-center"><span class="rd-count">@(item.EnrolmentCount ?? 0)</span></td>
                                    <td class="text-end">
                                        <a asp-action="Results" asp-route-id="@item.EventID" class="btn btn-rd btn-sm"><i class="bi bi-stopwatch"></i> Enter results</a>
                                        <a asp-action="Enrolments" asp-route-id="@item.EventID" class="btn btn-outline-dark btn-sm">Enrolments</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
