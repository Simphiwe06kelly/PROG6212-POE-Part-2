@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="container rd-center-page text-center">
    <div class="rd-error-code">@(Model.Code > 0 ? Model.Code.ToString() : "Oops")</div>
    <h1 class="rd-heading">@Model.Title</h1>
    <p class="lead text-muted">@Model.Message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-rd btn-lg mt-2"><i class="bi bi-house-door-fill"></i> Back to events</a>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>
