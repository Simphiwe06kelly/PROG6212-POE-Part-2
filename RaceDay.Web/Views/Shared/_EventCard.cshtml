@model EventDto
<div class="card rd-event-card h-100">
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventID"
       class="rd-event-media @Format.TypeClass(Model.EventType)" aria-label="View @Model.EventName">
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img src="@Model.BannerUrl" alt="Banner for @Model.EventName" loading="lazy" />
        }
        else
        {
            <i class="bi @Format.TypeIcon(Model.EventType) rd-event-media-icon"></i>
        }
        <span class="rd-type-pill"><i class="bi @Format.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
    </a>
    <div class="card-body d-flex flex-column">
        <div class="rd-date"><i class="bi bi-calendar-event"></i> @Format.Date(Model.EventDate)</div>
        <h3 class="h5 rd-event-title mt-1">@Model.EventName</h3>
        @if (Model.Venue != null)
        {
            <div class="text-muted small"><i class="bi bi-geo-alt-fill"></i> @Model.Venue.VenueName, @Model.Venue.City</div>
        }
        @if (Model.Categories.Any())
        {
            <div class="mt-2">
                @foreach (var category in Model.Categories.OrderBy(c => c.DistanceKm))
                {
                    <span class="rd-chip">@category.CategoryName</span>
                }
            </div>
        }
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventID" class="btn btn-rd mt-3 align-self-start">View event</a>
    </div>
</div>
