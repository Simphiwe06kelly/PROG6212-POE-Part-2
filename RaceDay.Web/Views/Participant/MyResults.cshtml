@model MyResultsViewModel
@{
    ViewData["Title"] = "My results";
    var finished = Model.Results.Count(r => r.Status == "Finished");
}

<div class="container my-4">
    <div class="mb-3">
        <h1 class="rd-heading mb-0">My results</h1>
        <p class="text-muted mb-0">Your race history across every event you have completed.</p>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="rd-empty">
            <i class="bi bi-trophy"></i>
            <h3>No results yet</h3>
            <p>Results appear here once an organiser captures them after your event.</p>
            <a asp-controller="Participant" asp-action="MyEnrolments" class="btn btn-rd">See my enrolments</a>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="rd-stat"><div class="rd-stat-number">@Model.Results.Count</div><div class="rd-stat-label">Races recorded</div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="rd-stat"><div class="rd-stat-number">@finished</div><div class="rd-stat-label">Finished</div></div>
            </div>
        </div>

        <div class="card rd-panel">
            <div class="table-responsive">
                <table class="table rd-table align-middle mb-0">
                    <thead>
                        <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.Results)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@result.EventID">@result.EventName</a>
                                </td>
                                <td>@Format.ShortDate(result.EventDate)</td>
                                <td>@result.CategoryName</td>
                                <td class="rd-time">@Format.Time(result.FinishTime)</td>
                                <td>@Format.Position(result)</td>
                                <td><partial name="_StatusBadge" model="result.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
